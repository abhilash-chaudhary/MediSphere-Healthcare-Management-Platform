# MediSphere Environment Settings

# MongoDB connection
MONGODB_URI=mongodb://localhost:27017

# JWT secret
JWT_SECRET=medisphere-secret-key-12345

# SMTP Email Configuration (Optional - for real email dispatches)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM="MediSphere Security" <your-email@gmail.com>
